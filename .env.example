# =============================================================================
#  LLM Task Manager — Environment Configuration
#  Copy to .env and adjust as needed:
#      cp .env.example .env
# =============================================================================

# ----- Application ----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# ----- Postgres (used by docker-compose to build DATABASE_URL) --------------
POSTGRES_USER=todo
POSTGRES_PASSWORD=todo
POSTGRES_DB=todo

# ----- Backend --------------------------------------------------------------
# In Docker: DATABASE_URL and REDIS_URL are overridden inline by docker-compose
# Local dev: change host to localhost
DATABASE_URL=postgresql+asyncpg://todo:todo@postgres:5432/todo
REDIS_URL=redis://redis:6379/0

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# ----- LLM Provider ---------------------------------------------------------
# Options: mock (no key needed), openai (requires OPENAI_API_KEY)
LLM_PROVIDER=mock
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
LLM_CACHE_TTL_SECONDS=3600
LLM_REQUEST_TIMEOUT=30

# ----- Frontend (used by Next.js in docker-compose) -------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
